doctype html
html(lang='id')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= title + ' | Applier Jobes'
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    main.error-page
      p.eyebrow APPLIER JOBES
      h1= title
      p= message
      if error.status
        p.error-code Kode: #{error.status}
      a.button.button-primary(href='/') Kembali
